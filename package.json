{
  "name": "ticiou",
  "version": "0.1.0",
  "description": "Multi-profile AI tool configuration compiler for Claude and Copilot",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ticiou": "./bin/ticiou.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.js",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0"
  },
  "license": "MIT",
  "keywords": [
    "claude",
    "copilot",
    "ai",
    "cli",
    "profile"
  ],
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}